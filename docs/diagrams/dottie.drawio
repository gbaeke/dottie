d="flow-lgt-5" value="In the sandbox" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1340" y="27" width="118" height="20" as="geometry"/></mxCell><mxCell id="flow-lg-6" value="" style="rounded=1;arcSize=25;fillColor=#F0FDFA;strokeColor=#5EEAD4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1460" y="30" width="14" height="14" as="geometry"/></mxCell><mxCell id="flow-lgt-7" value="Settling" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1480" y="27" width="118" height="20" as="geometry"/></mxCell><mxCell id="flow-grp-8" value="&lt;b&gt;1 · The app wakes the dottie&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#64748B&quot;&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;engine/&lt;/font&gt; · control plane&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F3FF;strokeColor=#C4B5FD;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#4C1D95;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1100" height="205" as="geometry"/></mxCell><mxCell id="flow-stage-9" value="&lt;div style=&quot;line-height:1.4&quot;&gt;From you (UI, MCP), the clock or another dottie.&lt;br&gt;One row in &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;messages&lt;/font&gt;, status &lt;b&gt;pending&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-8"><mxGeometry x="15" y="50" width="245" height="140" as="geometry"/></mxCell><mxCell id="flow-badge-10" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-9"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-11" value="&lt;b&gt;A message arrives&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#4C1D95;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-9"><mxGeometry x="46" y="10" width="189" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-12" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Leader lock in PostgreSQL.&lt;br&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;FOR UPDATE SKIP LOCKED&lt;/font&gt;, one run per dottie at a time.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-8"><mxGeometry x="285" y="50" width="245" height="140" as="geometry"/></mxCell><mxCell id="flow-badge-13" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-12"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-14" value="&lt;b&gt;The dispatcher claims it&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#4C1D95;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-12"><mxGeometry x="46" y="10" width="189" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-15" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A run row with a random token.&lt;br&gt;The messages become the run&#x27;s input.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-8"><mxGeometry x="555" y="50" width="245" height="140" as="geometry"/></mxCell><mxCell id="flow-badge-16" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-15"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-17" value="&lt;b&gt;A run starts&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#4C1D95;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-15"><mxGeometry x="46" y="10" width="189" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-18" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Resume it, or create it.&lt;br&gt;First time: install the runtime (~30 s).&lt;br&gt;Start &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;python -m dottie_runtime&lt;/font&gt; with the token.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-8"><mxGeometry x="825" y="50" width="245" height="140" as="geometry"/></mxCell><mxCell id="flow-badge-19" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-18"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-20" value="&lt;b&gt;The sandbox wakes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#4C1D95;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-18"><mxGeometry x="46" y="10" width="189" height="30" as="geometry"/></mxCell><mxCell id="flow-e-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-9" target="flow-stage-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-e-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-12" target="flow-stage-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-e-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-15" target="flow-stage-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-grp-24" value="&lt;b&gt;2 · In the sandbox&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#7C2D12;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="1100" height="215" as="geometry"/></mxCell><mxCell id="flow-stage-25" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;GET /internal/context&lt;/font&gt;: prompt, input, conversation so far, tool list.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-24"><mxGeometry x="15" y="50" width="195" height="150" as="geometry"/></mxCell><mxCell id="flow-badge-26" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EA580C;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-25"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-27" value="&lt;b&gt;Get the context&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#7C2D12;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-25"><mxGeometry x="46" y="10" width="139" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-28" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Deep Agent loop. Model calls go to &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/internal/llm&lt;/font&gt;: the app adds the credentials.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-24"><mxGeometry x="230" y="50" width="195" height="150" as="geometry"/></mxCell><mxCell id="flow-badge-29" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EA580C;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-28"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-30" value="&lt;b&gt;Think&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#7C2D12;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-28"><mxGeometry x="46" y="10" width="139" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-31" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Shell and &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/workspace&lt;/font&gt; are local. Wiki, skills and tools (messaging, schedules, web, MCP) go through &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/internal&lt;/font&gt;.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-24"><mxGeometry x="445" y="50" width="195" height="150" as="geometry"/></mxCell><mxCell id="flow-badge-32" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EA580C;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-31"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-33" value="&lt;b&gt;Act&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#7C2D12;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-31"><mxGeometry x="46" y="10" width="139" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-34" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Tool calls and wiki edits stream to &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;/internal/events&lt;/font&gt;: the activity feed.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-24"><mxGeometry x="660" y="50" width="195" height="150" as="geometry"/></mxCell><mxCell id="flow-badge-35" value="&lt;b&gt;8&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EA580C;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-34"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-36" value="&lt;b&gt;Report&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#7C2D12;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-34"><mxGeometry x="46" y="10" width="139" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-37" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;POST /internal/finish&lt;/font&gt; with the answer.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-24"><mxGeometry x="875" y="50" width="195" height="150" as="geometry"/></mxCell><mxCell id="flow-badge-38" value="&lt;b&gt;9&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#EA580C;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-37"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-39" value="&lt;b&gt;Finish&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#7C2D12;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-37"><mxGeometry x="46" y="10" width="139" height="30" as="geometry"/></mxCell><mxCell id="flow-e-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#EA580C;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-25" target="flow-stage-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-e-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#EA580C;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-28" target="flow-stage-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-e-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#EA580C;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-31" target="flow-stage-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-e-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#EA580C;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-34" target="flow-stage-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-grp-44" value="&lt;b&gt;3 · Back in the app&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F0FDFA;strokeColor=#5EEAD4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#134E4A;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1100" height="185" as="geometry"/></mxCell><mxCell id="flow-stage-45" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Reply posted to the chat or inbox, messages marked done, token revoked.&lt;br&gt;A dottie&#x27;s answer to a dottie is dropped: it uses &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;send_message&lt;/font&gt;.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-44"><mxGeometry x="15" y="50" width="340" height="120" as="geometry"/></mxCell><mxCell id="flow-badge-46" value="&lt;b&gt;10&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#0D9488;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-45"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-47" value="&lt;b&gt;The answer is delivered&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#134E4A;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-45"><mxGeometry x="46" y="10" width="284" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-48" value="&lt;div style=&quot;line-height:1.4&quot;&gt;The sandbox keeps running for &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;SANDBOX_IDLE_SECONDS&lt;/font&gt; (120).&lt;br&gt;A follow-up skips the resume.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-44"><mxGeometry x="375" y="50" width="340" height="120" as="geometry"/></mxCell><mxCell id="flow-badge-49" value="&lt;b&gt;11&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#0D9488;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-48"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-50" value="&lt;b&gt;A warm window&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#134E4A;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-48"><mxGeometry x="46" y="10" width="284" height="30" as="geometry"/></mxCell><mxCell id="flow-stage-51" value="&lt;div style=&quot;line-height:1.4&quot;&gt;No run for 120 s: &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;Engine.reap_idle&lt;/font&gt; stops the sandbox.&lt;br&gt;Its disk and memory file stay.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#5EEAD4;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=10;spacingTop=46;fontSize=11;fontColor=#475569;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="flow-grp-44"><mxGeometry x="735" y="50" width="340" height="120" as="geometry"/></mxCell><mxCell id="flow-badge-52" value="&lt;b&gt;12&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#0D9488;strokeColor=none;fontColor=#FFFFFF;fontSize=12;aspect=fixed;" vertex="1" parent="flow-stage-51"><mxGeometry x="12" y="12" width="26" height="26" as="geometry"/></mxCell><mxCell id="flow-st-53" value="&lt;b&gt;The reaper stops it&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#134E4A;strokeColor=none;fillColor=none;" vertex="1" parent="flow-stage-51"><mxGeometry x="46" y="10" width="284" height="30" as="geometry"/></mxCell><mxCell id="flow-e-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#0D9488;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-45" target="flow-stage-48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-e-55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#0D9488;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flow-stage-48" target="flow-stage-51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-e-56" value="start runtime, with token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.923;entryY=0;" edge="1" parent="1" source="flow-stage-18" target="flow-stage-25"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="987" y="330"/><mxPoint x="235" y="330"/></Array></mxGeometry></mxCell><mxCell id="flow-e-57" value="dottie reports its end" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;strokeColor=#EA580C;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.72;entryY=0;" edge="1" parent="1" source="flow-stage-37" target="flow-stage-45"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="1012" y="575"/><mxPoint x="300" y="575"/></Array></mxGeometry></mxCell><mxCell id="flow-grp-58" value="&lt;b&gt;Guardrails and memory&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECFEFF;strokeColor=#67E8F9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=15;fontColor=#164E63;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="480" height="440" as="geometry"/></mxCell><mxCell id="flow-chk-59" value="&lt;span style=&quot;font-size:11px;font-weight:bold;color:#164E63;letter-spacing:0.5px&quot;&gt;CREDENTIALS&lt;/span&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; The sandbox holds a run token, nothing else&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; The model identity stays in the app&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; Tool credentials (MCP servers) stay in the app&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; The token stops working when the run ends&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#67E8F9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontColor=#475569;" vertex="1" parent="flow-grp-58"><mxGeometry x="15" y="50" width="450" height="94" as="geometry"/></mxCell><mxCell id="flow-chk-60" value="&lt;span style=&quot;font-size:11px;font-weight:bold;color:#164E63;letter-spacing:0.5px&quot;&gt;LIMITS&lt;/span&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; Message hops: 5 (&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;MAX_MESSAGE_DEPTH&lt;/font&gt;)&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; Sends per waking: 5&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; Run time: 900 s (&lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;RUN_TIMEOUT_SECONDS&lt;/font&gt;)&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; &lt;font face=&quot;Courier New&quot; color=&quot;#0F172A&quot;&gt;fetch_url&lt;/font&gt;: public addresses only&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#67E8F9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontColor=#475569;" vertex="1" parent="flow-grp-58"><mxGeometry x="15" y="152" width="450" height="94" as="geometry"/></mxCell><mxCell id="flow-chk-61" value="&lt;span style=&quot;font-size:11px;font-weight:bold;color:#164E63;letter-spacing:0.5px&quot;&gt;WHEN IT FAILS&lt;/span&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; A runtime that dies is noticed within 15 s&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; An install failure shows the log tail&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; The user gets the error as a system message&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#67E8F9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontColor=#475569;" vertex="1" parent="flow-grp-58"><mxGeometry x="15" y="254" width="450" height="77" as="geometry"/></mxCell><mxCell id="flow-chk-62" value="&lt;span style=&quot;font-size:11px;font-weight:bold;color:#164E63;letter-spacing:0.5px&quot;&gt;MEMORY&lt;/span&gt;&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; Wiki and skills: PostgreSQL, read and written over HTTP&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; Conversation: SQLite on the sandbox disk&lt;br&gt;&lt;font color=&quot;#0891B2&quot;&gt;✓&lt;/font&gt;&amp;nbsp; A new sandbox rebuilds it from the transcript&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#67E8F9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontColor=#475569;" vertex="1" parent="flow-grp-58"><mxGeometry x="15" y="339" width="450" height="77" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
