# Dottie settings. Copy to .env (git ignores it) and adjust; every setting in config.py is listed here.

# --- App ---------------------------------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8370
# one JSON object per log line (on by default in Azure)
LOG_JSON=false

# --- Database: the local container (scripts/db.sh up). On Azure the deploy sets it. --------------------------------------
DATABASE_URL=postgresql://dottie:dottie@localhost:54845/dottie
# sign in with Entra (managed identity on Azure, your az login locally) instead of the password in DATABASE_URL
# DATABASE_ENTRA_AUTH=false

# --- Telegram: one bot (from @BotFather) for everyone; empty: off. Telegram calls <address>/telegram/webhook, so the
# address must be reachable from the internet: PUBLIC_URL, or TELEGRAM_WEBHOOK_URL when that is not (locally: the
# address of a tunnel such as `cloudflared tunnel --url http://localhost:8370`, which changes on every start).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=

# --- The engine ----------------------------------------------------------------------------------------------------------
# ENGINE_ENABLED=true
# POLL_SECONDS=0.5
# RUN_TIMEOUT_SECONDS=900
# MAX_MESSAGE_DEPTH=5
# MAX_WORKERS=4
USER_TIMEZONE=Europe/Brussels

# --- The model: Azure Foundry's OpenAI v1 endpoint, or any OpenAI-compatible gateway ---------------------------------------
# local: the agentgateway; on Azure: https://<resource>.openai.azure.com/openai/v1/
LLM_BASE_URL=http://localhost:4000/v1
# empty on Azure: the app's managed identity signs in (role "Cognitive Services OpenAI User")
LLM_API_KEY=not-needed
# the deployment name
LLM_MODEL=azure-gpt-6-luna
# LLM_USE_RESPONSES_API=true

# --- Where the agent's loop runs: app (in this process) or sandbox (inside the dottie's own sandbox) ---------------------
AGENT_MODE=sandbox
# how a sandbox reaches this app; empty: http://localhost:<port> (the docker sandbox shares the host network)
# SERVE=all
# GATEWAY_URL=

# --- The sandbox: none (no shell), docker (a container per dottie, local) or aca (Container Apps Sandboxes) -------------
SANDBOX_BACKEND=docker
# SANDBOX_IMAGE=python:3.14-slim
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
# SANDBOX_GROUP=
# SANDBOX_REGION=
# SANDBOX_IDLE_SECONDS=120
# SANDBOX_DOCKER_NETWORK=host

# --- Sign-in with WorkOS AuthKit: off while WORKOS_CLIENT_ID is empty (one local user, no login) ----------------------
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# SESSION_SECRET=
# ALLOWED_USERS=
# the address people use, when a proxy hides it (set by the Azure deploy)
# PUBLIC_URL=
# MAX_DOTTIES_PER_USER=20

# --- Secrets: encrypts what users store for their dotties. Any long random string: openssl rand -base64 32.
# Changing it makes the stored secrets unreadable. Empty: the secret store is off.
SECRETS_KEY=
